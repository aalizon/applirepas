# Mot de passe familial (laisser vide en local = pas de connexion demandée)
APP_PASSWORD=
# Chaîne aléatoire pour signer le cookie de session
SESSION_SECRET=
# Emplacement de la base SQLite (en production : HORS du dossier de l'application)
DATABASE_PATH=./data/applirepas.db
# Masque l'avertissement « SQLite is an experimental feature »
NODE_NO_WARNINGS=1
